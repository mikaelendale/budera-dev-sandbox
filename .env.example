APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: sqlite (CI/tests use this). Staging/production: use pgsql + redis for parity.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL (staging/production / Laravel Sail — see compose.yaml at repo root)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=budera
# DB_USERNAME=sail
# DB_PASSWORD=password
#
# Sail (`./vendor/bin/sail up`): DB_HOST=pgsql, REDIS_HOST=redis; Mailpit SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# (compose forwards 8025 for Mailpit UI; MOCK_BANK_BASE_URL=http://host.docker.internal:3000 if mock-bank runs on the host)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Passport OAuth: must be php so League authorization objects survive in session (json breaks POST /oauth/authorize)
SESSION_SERIALIZATION=php

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database = no Redis required (sqlite-friendly). redis = staging/production; run workers on all logical queues.
# Logical queues: default, payments (reserved for future async payment jobs), webhooks, notifications, compliance
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# When using redis driver: default connection queue name (per-job queues use config/budera.php queues.*)
# REDIS_QUEUE=default
# REDIS_QUEUE_CONNECTION=default

# Optional: override individual logical queue names (must match worker --queue= list)
# BUDERA_QUEUE_DEFAULT=default
# BUDERA_QUEUE_PAYMENTS=payments
# BUDERA_QUEUE_WEBHOOKS=webhooks
# BUDERA_QUEUE_NOTIFICATIONS=notifications
# BUDERA_QUEUE_COMPLIANCE=compliance

# Per-company API throttling (requests per minute; tier from companies.api_rate_limit_tier)
# BUDERA_API_RATE_LIMIT_DEFAULT=120
# BUDERA_API_RATE_LIMIT_GROWTH=300
# BUDERA_API_RATE_LIMIT_ENTERPRISE=1200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Docker/Sail: REDIS_HOST=redis

# Production email: set MAIL_MAILER=resend and provide RESEND_API_KEY
# Local: MAIL_MAILER=log (default) or MAIL_MAILER=mailpit with Mailpit (Sail)
# All supported: log | array | smtp | mailpit | resend | postmark
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (production/staging): composer includes resend/resend-php; set MAIL_MAILER=resend
# RESEND_API_KEY=

# Optional explicit Mailpit SMTP overrides (otherwise use MAIL_MAILER=mailpit)
# MAILPIT_SMTP_HOST=127.0.0.1
# MAILPIT_SMTP_PORT=1025

# Set false to suppress all transactional notifications (queued jobs still dispatch but should no-op if gated in sender)
# BUDERA_MAIL_TRANSACTIONAL_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# When true, OAuth clients skip the consent screen (sandbox / local SDK testing only).
OAUTH_SANDBOX_AUTO_APPROVE=false

# Column mock bank (see mock-bank/ and docs/mock-bank.md). From Docker app container use host.docker.internal if mock-bank runs on the host.
# Sail: MOCK_BANK_BASE_URL=http://mock-bank:3000 (compose service name)
MOCK_BANK_BASE_URL=http://127.0.0.1:3000
MOCK_BANK_SECRET=
# Must match BUDERA_WEBHOOK_SECRET in mock-bank/.env.local when webhooks are enabled
# Example webhook URL when using `php artisan serve`: http://127.0.0.1:8000/api/webhooks/mock-bank
MOCK_BANK_WEBHOOK_SECRET=
# true/false, or omit: when omitted, defaults to true in APP_ENV=local only (no mock-bank on :3000)
MOCK_BANK_INLINE=true

# Sail port forwarding for mock-bank container (compose.yaml)
# FORWARD_MOCK_BANK_PORT=3000

# Domain audit signing (RSA in production; HMAC fallback when RSA unavailable in non-production)
# BUDERA_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# BUDERA_RSA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
BUDERA_AUTH_HMAC_SECRET=

# Optional: also force-approve hosted/inline KYC when the wallet environment is live (staging).
# Sandbox-environment wallets auto-complete mock KYC without this flag.
# BUDERA_SANDBOX_FORCE_KYC_APPROVE=false

# Bank-link session lifetime (hours) before the session token expires
# BUDERA_BANK_LINK_SESSION_TTL_HOURS=72

# Cookie name for the dashboard sandbox/live environment selector
# BUDERA_DASHBOARD_ENVIRONMENT_COOKIE=budera_dashboard_environment

# Exact copy shown when users verify micro-deposits (ACH standing authorization)
# BUDERA_ACH_STANDING_AUTHORIZATION_TEXT="By verifying..."

# Budera admin seeder (php artisan db:seed --class=BuderaAdminSeeder)
# BUDERA_ADMIN_EMAIL=budera-admin@local.test
# BUDERA_ADMIN_NAME="Budera Admin"

# ---------------------------------------------------------------------------
# Horizon (requires QUEUE_CONNECTION=redis)
# ---------------------------------------------------------------------------
# HORIZON_NAME=
# HORIZON_DOMAIN=
# HORIZON_PATH=horizon
# HORIZON_PREFIX=
