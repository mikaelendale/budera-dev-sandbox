# Optional: when set, all bank API routes require X-Bank-Secret or Authorization: Bearer
MOCK_BANK_SECRET=

# Delays (milliseconds)
SETTLEMENT_DELAY_MS=500
WIRE_SETTLEMENT_DELAY_MS=400
SWIFT_SETTLEMENT_DELAY_MS=600
FEDNOW_SETTLEMENT_DELAY_MS=50
CHECK_MAIL_DELAY_MS=800
CHECK_CLEAR_DELAY_MS=1200
KYC_VERIFICATION_DELAY_MS=800

# Set to 1 or true to simulate KYC rejection
KYC_MOCK_REJECT=

# Where the mock POSTs webhooks (your Laravel URL + path)
BUDERA_WEBHOOK_URL=
# Shared secret; mock signs body with HMAC-SHA256 as X-Signature: sha256=<hex>
BUDERA_WEBHOOK_SECRET=
